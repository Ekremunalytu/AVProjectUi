QMainWindow {
    border-image: url(:/images/background.png) 0 0 0 0 stretch stretch;
    background-color: #1E1E1E;
}

/* HistoryWidget Buton Stilleri */

/* Birincil Butonlar (Örn: Karantinaya Git, Dosyayı Geri Yükle) */
QPushButton[objectName="goToQuarantineButton"],
QPushButton[objectName="restoreFileButton"] {
    background-color: #007AFF; /* Ana vurgu rengi - Mavi */
    color: white;
    border: 1px solid #007AFF;
    padding: 6px 12px; /* Biraz daha kompakt padding */
    border-radius: 4px;
    font-weight: bold;
    min-height: 28px; /* Butonların minimum yüksekliği */
}

QPushButton[objectName="goToQuarantineButton"]:hover,
QPushButton[objectName="restoreFileButton"]:hover {
    background-color: #005ECB; /* Hover durumunda biraz daha koyu mavi */
    border-color: #005ECB;
}

QPushButton[objectName="goToQuarantineButton"]:pressed,
QPushButton[objectName="restoreFileButton"]:pressed {
    background-color: #004C9A; /* Basılma durumunda daha da koyu mavi */
}

QPushButton[objectName="goToQuarantineButton"]:focus,
QPushButton[objectName="restoreFileButton"]:focus {
    border-color: #004C9A; /* Odak durumunda belirgin kenarlık */
    /* İsteğe bağlı: background-color: #0056b3; */
}

/* Yıkıcı Eylem Butonları (Örn: Kalıcı Sil, Tüm Geçmişi Temizle) */
QPushButton[objectName="permanentlyDeleteFileButton"],
QPushButton[objectName="clearAllHistoryButton"] {
    background-color: #DC3545; /* Kırmızı - Yıkıcı eylem */
    color: white;
    border: 1px solid #DC3545;
    padding: 6px 12px;
    border-radius: 4px;
    font-weight: bold;
    min-height: 28px;
}

QPushButton[objectName="permanentlyDeleteFileButton"]:hover,
QPushButton[objectName="clearAllHistoryButton"]:hover {
    background-color: #C82333;
    border-color: #C82333;
}

QPushButton[objectName="permanentlyDeleteFileButton"]:pressed,
QPushButton[objectName="clearAllHistoryButton"]:pressed {
    background-color: #B21F2D;
}

QPushButton[objectName="permanentlyDeleteFileButton"]:focus,
QPushButton[objectName="clearAllHistoryButton"]:focus {
    border-color: #B21F2D; /* Odak durumunda belirgin kenarlık */
    /* İsteğe bağlı: background-color: #9a1a27; */
}

/* İkincil Butonlar (Çerçeveli/Outlined) */
QPushButton[objectName="viewDetailsButton"],
QPushButton[objectName="addToExclusionsButton"],
QPushButton[objectName="submitSampleButton"],
QPushButton[objectName="exportButton"],
QPushButton[objectName="generateReportButton"] {
    background-color: transparent;
    color: #007AFF; /* Ana vurgu rengiyle uyumlu metin */
    border: 1px solid #007AFF;
    padding: 6px 12px;
    border-radius: 4px;
    min-height: 28px;
}

QPushButton[objectName="viewDetailsButton"]:hover,
QPushButton[objectName="addToExclusionsButton"]:hover,
QPushButton[objectName="submitSampleButton"]:hover,
QPushButton[objectName="exportButton"]:hover,
QPushButton[objectName="generateReportButton"]:hover {
    background-color: rgba(0, 122, 255, 0.1); /* Hafif mavi dolgu (alpha ile) */
    color: #005ECB;
}

QPushButton[objectName="viewDetailsButton"]:pressed,
QPushButton[objectName="addToExclusionsButton"]:pressed,
QPushButton[objectName="submitSampleButton"]:pressed,
QPushButton[objectName="exportButton"]:pressed,
QPushButton[objectName="generateReportButton"]:pressed {
    background-color: rgba(0, 122, 255, 0.2); /* Basılma durumunda biraz daha belirgin dolgu */
}

QPushButton[objectName="viewDetailsButton"]:focus,
QPushButton[objectName="addToExclusionsButton"]:focus,
QPushButton[objectName="submitSampleButton"]:focus,
QPushButton[objectName="exportButton"]:focus,
QPushButton[objectName="generateReportButton"]:focus {
    border-color: #005ECB; /* Odak durumunda daha koyu kenarlık */
    background-color: rgba(0, 122, 255, 0.05); /* Çok hafif dolgu */
}

/* Daha Az Belirgin İkincil Buton (Hayalet Buton - Olayı Sil) */
QPushButton[objectName="deleteEventButton"] {
    background-color: transparent;
    color: #6c757d; /* Nötr bir renk */
    border: none;
    padding: 6px 12px;
    text-decoration: none; /* Genellikle altı çizili olmayan tercih edilir */
    min-height: 28px;
}

QPushButton[objectName="deleteEventButton"]:hover {
    color: #5a6268;
    background-color: rgba(108, 117, 125, 0.1); /* Hafif gri hover */
}

QPushButton[objectName="deleteEventButton"]:pressed {
    color: #495057;
    background-color: rgba(108, 117, 125, 0.2);
}

/* Butonlar için Devre Dışı Durum Stilleri */
QPushButton:disabled {
    background-color: #e9ecef !important; /* Genel devre dışı arka planı */
    color: #6c757d !important;           /* Genel devre dışı metin rengi */
    border-color: #ced4da !important;    /* Genel devre dışı kenarlık rengi */
}

/* Birincil Butonlar Devre Dışı */
QPushButton[objectName="goToQuarantineButton"]:disabled,
QPushButton[objectName="restoreFileButton"]:disabled {
    background-color: #cce5ff !important;
    color: #004085 !important;
    border-color: #b8daff !important;
}

/* Yıkıcı Eylem Butonları Devre Dışı */
QPushButton[objectName="permanentlyDeleteFileButton"]:disabled,
QPushButton[objectName="clearAllHistoryButton"]:disabled {
    background-color: #f8d7da !important;
    color: #721c24 !important;
    border-color: #f5c6cb !important;
}

/* İkincil ve Hayalet Butonlar Devre Dışı */
QPushButton[objectName="viewDetailsButton"]:disabled,
QPushButton[objectName="addToExclusionsButton"]:disabled,
QPushButton[objectName="submitSampleButton"]:disabled,
QPushButton[objectName="exportButton"]:disabled,
QPushButton[objectName="generateReportButton"]:disabled,
QPushButton[objectName="deleteEventButton"]:disabled {
    color: #adb5bd !important;
    border-color: #dee2e6 !important; /* Varsa kenarlık rengi */
    background-color: transparent !important; /* Şeffaf arka planı koru */
}

/* Genel Buton İyileştirmeleri (İkonlar için yer bırakma vb.) */
QPushButton {
    /* İkon ve metin arasında boşluk (eğer ikonlar QSS ile değil de UI dosyasından ekleniyorsa) */
    /* spacing: 5px; */ /* Bu özellik doğrudan QSS'de yok, layout veya C++ ile ayarlanır */
    text-align: center; /* Metni ortala */
}

/* İkonlu butonlar için özel padding ayarı gerekebilir,
   ikonun pozisyonuna göre (sol/sağ) padding-left veya padding-right artırılabilir.
   Örnek:
QPushButton#goToQuarantineButton {
    padding-left: 25px; /* İkon için solda yer aç */
    icon: url(:/icons/quarantine_icon.svg);
    qproperty-iconSize: 16px 16px;
}
*/

/* ComboBox ve DateEdit Stilleri (Genel Modern Görünüm İçin) */
QComboBox, QDateEdit {
    padding: 5px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    min-height: 28px; /* Butonlarla aynı yükseklik */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #ced4da;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(:/icons/arrow_down.svg); /* Projenizde uygun bir ikon yolu belirtin */
    width: 12px;
    height: 12px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #ced4da;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QDateEdit::down-arrow {
    image: url(:/icons/calendar_icon.svg); /* Projenizde uygun bir ikon yolu belirtin */
    width: 12px;
    height: 12px;
}

QLineEdit {
    padding: 5px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    min-height: 28px; /* Butonlarla aynı yükseklik */
}

QTableView {
    border: 1px solid #ced4da;
    border-radius: 4px;
    gridline-color: #e9ecef; /* Izgara çizgileri için daha yumuşak bir renk */
    alternate-background-color: #f8f9fa; /* Alternatif satır rengi */
}

QHeaderView::section {
    background-color: #e9ecef;
    padding: 4px;
    border: 1px solid #dee2e6;
    font-weight: bold;
}

QGroupBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    margin-top: 10px; /* GroupBox başlığı için üstte boşluk */
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px 0 5px;
    left: 10px; /* Başlığın soldan hizalanması */
}

QTextBrowser {
    border: 1px solid #ced4da;
    border-radius: 4px;
    background-color: white;
}

/* ScrollBar Stilleri (Opsiyonel, daha modern bir görünüm için) */
QScrollBar:vertical {
    border: 1px solid #ced4da;
    background: #f8f9fa;
    width: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #adb5bd;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: 1px solid #ced4da;
    background: #f8f9fa;
    height: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal {
    background: #adb5bd;
    min-width: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

