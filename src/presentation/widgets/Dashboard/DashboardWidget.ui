         <property name="styleSheet">
          <string>
QFrame {
    border: 1px solid #4CAF50;
    background-color: rgba(232, 245, 233, 0.7);
    border-radius: 6px;
    padding: 8px;
}
QRadioButton {
    color: #2E7D32;
    font-weight: 500;
    font-size: 11px;
    spacing: 5px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}
QRadioButton::indicator:unchecked {
    border: 2px solid #4CAF50;
    border-radius: 8px;
    background-color: white;
}
QRadioButton::indicator:checked {
    border: 2px solid #2E7D32;
    border-radius: 8px;
    background-color: #4CAF50;
}
          </string>
         </property>
         <layout class="QHBoxLayout" name="basicScanControlsLayout">
          <item>
           <widget class="QLabel" name="scanTypeLabel">
