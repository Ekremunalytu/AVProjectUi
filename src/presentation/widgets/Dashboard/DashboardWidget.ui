 <class>DashboardWidget</class>
 <widget class="QWidget" name="DashboardWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>750</width>
    <height>550</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <item>
    <widget class="QTabWidget" name="dashboardTabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <property name="tabShape">
      <enum>QTabWidget::Rounded</enum>
     </property>
     <property name="documentMode">
      <bool>true</bool>
     </property>
     <property name="tabsClosable">
      <bool>false</bool>
     </property>
     <property name="movable">
      <bool>false</bool>
     </property>
     <property name="styleSheet">
      <string>
QTabWidget::pane { 
  border: 2px solid #2E7D32;
  border-radius: 8px;
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                              stop: 0 rgba(46, 125, 50, 0.1),
                              stop: 1 rgba(0, 0, 0, 0.05));
  margin-top: -1px;
  padding: 4px;
}
QTabWidget::tab-bar {
  left: 8px;
}
QTabBar::tab {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                              stop: 0 rgba(69, 90, 100, 0.8),
                              stop: 1 rgba(38, 50, 56, 0.9));
  border: 2px solid #37474F;
  border-bottom: 0px;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  padding: 10px 20px;
  margin-right: 3px;
  color: #B0BEC5;
  font-weight: 500;
  font-size: 11px;
  min-width: 80px;
}
QTabBar::tab:selected {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                              stop: 0 rgba(46, 125, 50, 0.9),
                              stop: 1 rgba(27, 94, 32, 0.8));
  color: #FFFFFF;
  border: 2px solid #2E7D32;
  font-weight: 600;
}
QTabBar::tab:hover:!selected {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                              stop: 0 rgba(96, 125, 139, 0.7),
                              stop: 1 rgba(55, 71, 79, 0.8));
  color: #E0E0E0;
}
      </string>
     </property>
     
     <!-- Basic Scan Tab -->
     <widget class="QWidget" name="basicScanTab">
      <attribute name="title">
