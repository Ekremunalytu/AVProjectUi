        <property name="styleSheet">
            <string>
                #ServiceStatusWidget {
                    background-color: transparent;
                    color: #E0E0E0; /* Light gray for general text */
                }
                QScrollArea#scrollArea {
                    background-color: transparent;
                    border: none;
                }
                QWidget#scrollAreaWidgetContents {
                    background-color: transparent;
                }
                QGroupBox {
                    border: 1px solid #4A4A4A; /* Darker gray border */
                    margin-top: 1.5ex; /* Space for the title */
                    padding: 10px;
                    border-radius: 5px; /* Rounded corners */
                }
                QGroupBox::title {
                    subcontrol-origin: margin;
                    subcontrol-position: top left; /* position at the top left */
                    padding: 0 5px;
                    color: #4DB6AC; /* Teal for titles */
                    font-weight: bold;
                }
                QLabel[objectName*="Title"] { /* Targets labels like labelRealTimeTitle */
                    color: #BDBDBD; /* Slightly lighter gray for section titles */
                }
                QLabel[objectName*="Value"], QLabel[objectName*="Status"] { /* Targets labels like labelRealTimeStatus */
                    color: #80CBC4; /* Lighter Teal for values/statuses */
                    font-weight: normal; /* Ensure value labels are not bold by default from parent */
                }
                #labelOverallStatusValue {
                    font-weight: bold; /* Make overall status value bold */
                    color: #A5D6A7; /* Light Green for overall status, can be adjusted */
                }
                QGroupBox#groupBoxCoreProtection QFrame {
                    border-bottom: 1px solid #3A3A3A; /* Subtle line between frames */
                    padding-bottom: 8px; /* Space below the line */
                    margin-bottom: 8px; /* Space before the next frame */
                }
                QGroupBox#groupBoxCoreProtection QFrame:last-child {
                    border-bottom: none; /* No line for the last frame */
                    margin-bottom: 0;
                    padding-bottom: 0;
                }
                QPushButton#buttonRefresh {
                    background-color: #00796B; /* Darker Teal */
                    color: white;
                    border: none;
                    padding: 8px 16px;
                    border-radius: 4px;
                }
                QPushButton#buttonRefresh:hover {
                    background-color: #004D40; /* Even Darker Teal on hover */
                }
                QCheckBox#checkBoxDetailedView {
                    color: #BDBDBD; /* Match title label color */
                }
                QCheckBox#checkBoxDetailedView::indicator {
                    width: 15px;
                    height: 15px;
                    /* Add more indicator styling if needed */
                }
            </string>
        </property>
