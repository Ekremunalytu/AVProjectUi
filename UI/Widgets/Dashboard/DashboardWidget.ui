<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DashboardWidget</class>
 <widget class="QWidget" name="DashboardWidget">
  <layout class="QVBoxLayout" name="verticalLayout_2">
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_Main">
     <item>
      <widget class="QListWidget" name="sideMenuWidget">
       <property name="minimumSize">
        <size>
         <width>150</width>
         <height>0</height>
        </size>
       </property>
       <property name="maximumSize">
        <size>
         <width>200</width>
         <height>16777215</height>
        </size>
       </property>
       <item>
        <property name="text">
         <string>Genel Bakış</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Network</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Malware Analizi</string>
        </property>
       </item>
       <!-- Diğer menü elemanları buraya eklenebilir -->
      </widget>
     </item>
     <item>
      <widget class="QStackedWidget" name="contentStackedWidget">
       <widget class="QWidget" name="overviewPage">
        <!-- Genel Bakış sayfasının içeriği buraya gelecek -->
        <!-- Örnek olarak bir label ekleyelim -->
        <layout class="QVBoxLayout" name="verticalLayout_overview">
         <item>
          <widget class="QLabel" name="labelOverview">
           <property name="text">
            <string>Genel Bakış Sayfası</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignCenter</set>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="networkPage">
        <layout class="QVBoxLayout" name="networkTabLayout"/>
        <!-- NetworkMonitorWidget buraya DashboardWidget.cpp içinde eklenecek -->
       </widget>
       <widget class="QWidget" name="malwareAnalysisPage">
        <layout class="QVBoxLayout" name="verticalLayout_malware">
         <item>
          <widget class="QTabWidget" name="malwareAnalysisTabWidget">
           <widget class="QWidget" name="basicScanResultsTab">
            <attribute name="title">
             <string>Basic Scan</string>
            </attribute>
            <layout class="QVBoxLayout" name="verticalLayout_basicScan">
             <item>
              <widget class="QPushButton" name="basicScanFileButton">
               <property name="text">
                <string>Select File for Basic Scan</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QTextEdit" name="basicScanResultsTextEdit"/>
             </item>
            </layout>
           </widget>
           <widget class="QWidget" name="advancedScanResultsTab">
            <attribute name="title">
             <string>Advanced Scan</string>
            </attribute>
            <layout class="QVBoxLayout" name="verticalLayout_advancedScan">
             <item>
              <widget class="QPushButton" name="advancedScanFileButton">
               <property name="text">
                <string>Select File for Advanced Scan</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QTableWidget" name="advancedScanResultsTableWidget"/>
             </item>
            </layout>
           </widget>
           <widget class="QWidget" name="cdrResultsTab">
            <attribute name="title">
             <string>CDR Analysis</string>
            </attribute>
            <layout class="QVBoxLayout" name="verticalLayout_cdr">
             <item>
              <widget class="QPushButton" name="cdrScanButton">
               <property name="text">
                <string>Start CDR Analysis</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QTextEdit" name="cdrResultsTextEdit"/>
             </item>
            </layout>
           </widget>
           <widget class="QWidget" name="sandboxResultsTab">
            <attribute name="title">
             <string>Sandbox Analysis</string>
            </attribute>
            <layout class="QVBoxLayout" name="verticalLayout_sandbox">
             <item>
              <widget class="QPushButton" name="sandboxScanButton">
               <property name="text">
                <string>Start Sandbox Analysis</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QTextEdit" name="sandboxResultsTextEdit"/>
             </item>
            </layout>
           </widget>
          </widget>
         </item>
        </layout>
       </widget>
       <!-- Diğer sayfalar buraya eklenebilir -->
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources>
  <include location="../../resources.qrc"/>
 </resources>
 <connections/>
</ui>
