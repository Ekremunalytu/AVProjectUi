{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "📚 Generate Documentation",
            "type": "shell",
            "command": "sh",
            "args": [
                "tools/scripts/docs.sh",
                "generate"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Generate API documentation using Doxygen"
        },
        {
            "label": "🚀 Serve Documentation",
            "type": "shell",
            "command": "sh",
            "args": [
                "tools/scripts/docs.sh",
                "serve"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Start HTTP server for documentation",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "📖 Generate and Serve Documentation",
            "type": "shell",
            "command": "sh",
            "args": [
                "tools/scripts/docs.sh",
                "build-serve"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Generate documentation and start HTTP server",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "🔗 Open Documentation",
            "type": "shell",
            "command": "sh",
            "args": [
                "tools/scripts/docs.sh",
                "open"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Open documentation in default browser"
        },
        {
            "label": "📊 Documentation Status",
            "type": "shell",
            "command": "sh",
            "args": [
                "tools/scripts/docs.sh",
                "status"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
            "detail": "Show documentation generation status and statistics"
        },
        {
            "label": "🏗️ UML Viewer",
            "type": "shell",
            "command": "sh",
            "args": [
                "tools/scripts/docs.sh",
                "uml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Start HTTP server with UML diagram viewer focus",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "🧹 Clean Documentation",
            "type": "shell",
            "command": "sh",
            "args": [
                "tools/scripts/docs.sh",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Remove generated documentation files"
        },
        {
            "label": "🏗️ Build Project",
            "type": "shell",
            "command": "make",
            "args": [
                "build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "🧪 Run Tests",
            "type": "shell",
            "command": "make",
            "args": [
                "test"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "🏗️ Build and Test",
            "type": "shell",
            "command": "make",
            "args": [
                "build-and-test"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOrder": "sequence"
        }
    ]
}
